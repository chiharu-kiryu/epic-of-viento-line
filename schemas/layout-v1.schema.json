{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parser layout v1",
  "description": "Derived from source structure. Document types do not prescribe fields or card positions.",
  "type": "object",
  "required": ["schemaVersion", "sections"],
  "properties": {
    "schemaVersion": { "const": "viento-layout-v1" },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "level", "blocks"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "level": { "type": "integer", "minimum": 1, "maximum": 6 },
          "anchor": { "type": "string" },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "enum": ["kv", "paragraph", "list", "table", "code", "json", "image", "video", "audio"] },
                "key": { "type": "string" },
                "value": {},
                "text": { "type": "string" },
                "items": { "type": "array" },
                "rows": { "type": "array" }
              }
            }
          }
        }
      }
    }
  }
}
