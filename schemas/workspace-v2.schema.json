{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workspace-v2",
  "type": "object",
  "required": [
    "format",
    "version",
    "id",
    "name",
    "createdAt",
    "paths",
    "assetStores"
  ],
  "properties": {
    "format": {
      "const": "viento-workspace"
    },
    "version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "integer",
      "minimum": 0
    },
    "paths": {
      "const": {
        "documents": "design-data",
        "templates": "data-template",
        "metadata": "metadata"
      }
    },
    "assetStores": {
      "const": {
        "main": {
          "path": "assets"
        }
      }
    },
    "documentTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "project-type-v1.schema.json"
      }
    }
  }
}
