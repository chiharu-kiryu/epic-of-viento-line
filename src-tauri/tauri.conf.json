{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Viento Studio",
  "version": "0.3.1",
  "identifier": "io.viento.studio",
  "build": {
    "beforeDevCommand": "node desktop/prepare.mjs",
    "beforeBuildCommand": "node desktop/prepare.mjs",
    "beforeBundleCommand": "node desktop/prepare-bundle.mjs",
    "frontendDist": "../desktop/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Viento Studio · 作品库",
        "width": 1040,
        "height": 740,
        "minWidth": 680,
        "minHeight": 500,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "capabilities": [
        "library"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "故事与游戏策划资料编辑器",
    "longDescription": "本地作品库、文档编辑、素材管理与可校验的备份迁移。",
    "externalBin": [
      "binaries/viento-node"
    ],
    "resources": {
      "../desktop/resources/": "runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.5"
    }
  }
}
